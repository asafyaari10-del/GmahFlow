# העתיקו את הקובץ הזה ל-.env ומלאו את הפרטים של ה-PostgreSQL שלכם.
# הקובץ .env לא עולה ל-Git ולא נשלח למרצה (הסיסמה לא נחשפת בקוד).
PGHOST=localhost
PGPORT=5432
PGDATABASE=gmahflow
PGUSER=postgres
PGPASSWORD=your_password_here

PORT=3000
# כתובת האתר (משמשת לקישורי משוב בהודעות)
APP_URL=http://localhost:3000
